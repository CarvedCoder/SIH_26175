# ============================================================================
# DepthWizard — environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit the filled-in .env
# (it is gitignored). Every variable below is optional unless marked
# REQUIRED — sensible local-development defaults are built in.
# ============================================================================

# ── Supabase authentication ────────────────────────────────────────────────
# Supabase OWNS authentication. When either SUPABASE_JWT_SECRET (HS256
# projects) or SUPABASE_URL (asymmetric keys, JWKS) is set, every /api/v1
# route requires a Bearer access token issued by Supabase.
# Find these in your Supabase dashboard: Project Settings → API.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ANON_KEY=

# ── SQL persistence (scene/job/result metadata) ───────────────────────────
# MAIN DATABASE: SQLite by default (zero-config, stored at data/depthwizard.db).
# To leave DATABASE_URL empty/commented and run SQLite, do nothing — it just works.
# ADDITION (optional upgrade): Supabase hosted PostgreSQL — use the pooled
# connection string from Project Settings → Database with the +psycopg driver,
# e.g.:
#   postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local docker-compose PostgreSQL (matches docker-compose.yml) is also supported:
#   postgresql+psycopg://depthwizard:depthwizard@localhost:5432/depthwizard
#DATABASE_URL=sqlite:///data/depthwizard.db

# ── Object storage (RustFS / S3 API) ──────────────────────────────────────
# STORAGE_BACKEND=local keeps the pre-migration filesystem-only behavior.
STORAGE_BACKEND=s3
# S3_ENDPOINT: what the BACKEND talks to. Host-side dev: localhost:9000.
# Inside docker-compose this is overridden to http://rustfs:9000.
S3_ENDPOINT=localhost:9000
# S3_PUBLIC_ENDPOINT: what PRESIGNED URLs embed — the host the BROWSER
# must reach. Same as S3_ENDPOINT for host-side dev; inside docker-compose
# it is overridden to http://localhost:9000 (containers reach RustFS via
# the internal name, the browser via the published port).
#S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=depthwizard
S3_SECRET_KEY=depthwizard-secret
S3_BUCKET=depthwizard
S3_REGION=us-east-1
S3_SECURE=false
# Signed-URL lifetime in seconds (short-lived by design):
STORAGE_SIGNED_URL_TTL=300

# ── DepthWizard inference (canonical config for the serving path) ──────────
# Checkpoint: empty => outputs/calib_net/postproc_flagship/best.pt, then ./best.pt
DW_CKPT=
# Per-backend overrides — WIN over DW_CKPT for their backend, so the
# webapp HEIGHT MODEL switch can serve a fine-tuned RDAH net AND a
# CalibrationNet checkpoint at once (DW_CKPT only fits one architecture):
#   DW_CKPT_RDAH=outputs/rdah_gamus/best.pt   (fine-tuned RDAH-Net)
#   DW_CKPT_CALIB=outputs/calib_net/<run>/best.pt
DW_CKPT_RDAH=
DW_CKPT_CALIB=
# TerraHeight-S (external pretrained GAMUS AGL model — Depth Anything V2
# Small backbone; height backend "terraheight_s"). NOT auto-downloaded:
# set this to the local TerraHeight-S release checkpoint, e.g.
DW_CKPT_TERRAHEIGHT=best_model.pth
# (fallbacks: repo-root best_model.pth). Tiled inference knobs:
#   tile size (px, multiple of 14; default 630 = published GAMUS crop)
DW_TERRHEIGHT_TILE_SIZE=630
#   stride between windows (px; default 473 = 630 - 157 overlap blend)
DW_TERRHEIGHT_TILE_STRIDE=473
#   batch size (default 1 — the verified 6 GB VRAM-safe value)
DW_TERRHEIGHT_BATCH_SIZE=1
DW_CKPT_SHA256=
DW_DEVICE=auto
DW_BACKBONE=depth-anything/Depth-Anything-V2-Base-hf
# Set to 1 to disable the live DAv2 fallback (offline honesty)
DW_NO_LIVE=
# Optional inputs (empty => auto / none):
#   DW_DN_PATH     force a specific Dn normalization raster
#   DW_ANCHOR_DEM  anchor the DSM to a reference DEM
#   DW_CACHE_DIR   backbone weight cache directory
DW_DN_PATH=
DW_ANCHOR_DEM=
DW_CACHE_DIR=
# Post-processing preset: none|median|guided|bilateral|wls|conf|semantic|full
# WLS defaults render buildings as boxy volumes: high lambda dominates the
# data term inside RGB-coherent segments (flat roofs), small sigma_rgb
# hard-gates smoothing at RGB edges (sharp walls).
DW_POSTPROCESS=wls
DW_WLS_LAMBDA=50.0
DW_WLS_SIGMA_RGB=0.04
DW_WLS_MAX_ITER=300
# Flip/rotate ensemble inside the refinement (runtime ~3-4x)
DW_TTA=false

# ── Localized Disaster Assessment (HOTOSM ONNX Models) ─────────────────────
# Automatic building detection + 4-class earthquake damage severity pipeline.
# Set DW_DISASTER_ENABLED=false to bypass disaster stage during scene processing.
DW_DISASTER_ENABLED=true
# ONNX model paths (relative to the project root or absolute).
DW_BUILDING_MODEL_ONNX=local_model.onnx
DW_DAMAGE_MODEL_ONNX=model.onnx
DW_BUILDING_THRESHOLD=0.5
# Inference device for the disaster stage: auto (GPU w/ CPU fallback), cuda, cpu
DW_DISASTER_DEVICE=auto
# Sliding-window parameters for the building model and damage batch size
DW_DISASTER_TILE_SIZE=256
DW_DISASTER_TILE_STRIDE=128
DW_DISASTER_BATCH_SIZE=1
# Recover completely-destroyed structures the building detector misses
# (rubble is invisible to the building model; the damage model's own
# destroyed-class output is used instead). Recovered footprints are
# flagged for review in the API/GeoJSON.
DW_DISASTER_RECOVER_DESTROYED=true

# Route Assist damage penalty integration (damage modifies the existing
# building-obstacle cost; it never doubles as a semantic class)
DW_ROUTE_DAMAGE_ENABLED=true
DW_ROUTE_DAMAGE_MINOR_COST=3.0
DW_ROUTE_DAMAGE_MAJOR_COST=20.0
DW_ROUTE_DAMAGE_DESTROYED_COST=50.0

# ── Backend serving ───────────────────────────────────────────────────────
DW_API_KEY=
DW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DW_MAX_UPLOAD_BYTES=524288000
DW_MAX_CONCURRENT_JOBS=1
DW_JOB_TTL_SECONDS=86400
# Durable job store: file (JSON per scene) | sqlite | postgres (use with
# the Supabase/PostgreSQL DATABASE_URL above for full-SQL persistence):
DW_JOB_STORE=file

# ── docker-compose infrastructure ─────────────────────────────────────────
POSTGRES_PASSWORD=depthwizard

# ── Frontend (frontend/.env — Vite only exposes VITE_* vars) ──────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8010/api/v1
