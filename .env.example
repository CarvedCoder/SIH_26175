# ============================================================================
# DepthWizard — environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit the filled-in .env
# (it is gitignored). Every variable below is optional unless marked
# REQUIRED — sensible local-development defaults are built in.
# ============================================================================

# ── Supabase authentication ────────────────────────────────────────────────
# Supabase OWNS authentication. When either SUPABASE_JWT_SECRET (HS256
# projects) or SUPABASE_URL (asymmetric keys, JWKS) is set, every /api/v1
# route requires a Bearer access token issued by Supabase.
# Find these in your Supabase dashboard: Project Settings → API.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ANON_KEY=

# ── SQL persistence (scene/job/result metadata) ───────────────────────────
# Supabase hosted PostgreSQL: use the pooled connection string from
# Project Settings → Database, with the +psycopg driver, e.g.
#   postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local docker-compose default (matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg://depthwizard:depthwizard@localhost:5432/depthwizard

# ── Object storage (MinIO / S3 API) ───────────────────────────────────────
# STORAGE_BACKEND=local keeps the pre-migration filesystem-only behavior.
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=depthwizard
MINIO_ROOT_PASSWORD=depthwizard-secret
MINIO_ACCESS_KEY=depthwizard
MINIO_SECRET_KEY=depthwizard-secret
MINIO_BUCKET=depthwizard
MINIO_REGION=
MINIO_SECURE=false
# Signed-URL lifetime in seconds (short-lived by design):
STORAGE_SIGNED_URL_TTL=300

# ── DepthWizard inference ─────────────────────────────────────────────────
DW_CKPT=
DW_CKPT_SHA256=
DW_DEVICE=auto
DW_BACKBONE=depth-anything/Depth-Anything-V2-Base-hf
DW_NO_LIVE=

# ── Backend serving ───────────────────────────────────────────────────────
DW_API_KEY=
DW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DW_MAX_UPLOAD_BYTES=524288000
DW_MAX_CONCURRENT_JOBS=1
DW_JOB_TTL_SECONDS=86400

# ── docker-compose infrastructure ─────────────────────────────────────────
POSTGRES_PASSWORD=depthwizard

# ── Frontend (frontend/.env — Vite only exposes VITE_* vars) ──────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000/api/v1
