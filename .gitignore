# Generated / large geospatial data - never committed.
data/raw/*
data/process/*
data/output/*

!data/raw/
!data/raw/.gitkeep

!data/process/
!data/process/.gitkeep
!data/process/tiles/
!data/process/tiles/.gitkeep

!data/output/
!data/output/.gitkeep

*.tif
*.tiff
*.png
!docs/**/*.png

# Precomputed jury-demo bundles (mock backend) are checked in
tools/demo_bundles/**
!tools/demo_bundles/**

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# OS/editor cruft
.DS_Store
.vscode/
.idea/

# Node / Frontend
node_modules/
dist/
build/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

rgb_data/
rgb_data_truth/
worklog.md
val_tiles.txt
outputs/**
# The serving checkpoint ships with the repo (464K, tiny) so fresh clones
# report model_loaded: true. Un-ignore each parent dir level so the
# negation below can reach the file (git cannot re-include inside an
# excluded DIRECTORY, only inside excluded patterns).
!outputs/
!outputs/calib_net/
outputs/calib_net/**
!outputs/calib_net/gamus_rgb_grad/
outputs/calib_net/gamus_rgb_grad/**
!outputs/calib_net/gamus_rgb_grad/best.pt

gamus_full
sih.zip


# local dev databases
*.db
*.db-shm
*.db-wal
